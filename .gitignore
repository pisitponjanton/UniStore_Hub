*-report.md
/report.md

# Local secrets and machine-specific environment files
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Package dependencies, build outputs and local tool caches
**/node_modules/
**/.next/
**/.nuxt/
**/.turbo/
**/.cache/
**/.build/
**/build/
**/dist/
**/out/
**/coverage/
**/.nyc_output/
**/*.tsbuildinfo

# Quality-assurance artifacts (keep test source/docs, not generated evidence)
**/.evidence/
**/test-results/
**/playwright-report/
**/blob-report/
**/allure-results/
**/allure-report/

# Temporary files, logs and OS/editor caches
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
**/.idea/
**/.vscode/

# Python virtual environments and generated bytecode
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
