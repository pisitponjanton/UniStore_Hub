{
  "name": "unistore-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:security:braces": "node scripts/security/verify-braces.cjs",
    "test:e2e:cross-role": "node scripts/quality/run-cross-role-regression.cjs",
    "test:security:gate": "node --test scripts/security/audit-review.test.cjs",
    "audit:review": "node scripts/security/audit-review.cjs",
    "test:security:runtime": "node --test scripts/security/verify-runtime-isolation.test.cjs && node scripts/security/verify-runtime-isolation.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "braces": "file:vendor/braces-3.0.3.tgz",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
